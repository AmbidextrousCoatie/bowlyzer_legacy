    {

      "id": "bayerische-senioren-trio",

      "label": "Bayerische Meisterschaft Senioren Trio",

      "multi_file": true,

      "filename_patterns": [

        "(?i)bm20\\d{2}_sen_trio_erg(?:_[a-z0-9_]+)?\\.pdf$",

        "(?i)senioren_trio/sentrio[a-z]+\\.pdf$",

        "(?i)senioren_trio/erg-[a-z0-9_-]+\\.pdf$",

