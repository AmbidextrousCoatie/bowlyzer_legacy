[Unit]
Description=Bowl-A-Lyzer Clubmeisterschaft Donaubowler Dropbox import
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=bowlyzer
Group=bowlyzer
EnvironmentFile=-/etc/bowlyzer/clubmeisterschaft-import.env
ExecStart=/usr/local/bin/clubmeisterschaft_auto_import.sh
# Log import output in journald
StandardOutput=journal
StandardError=journal
