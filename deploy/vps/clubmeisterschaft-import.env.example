# User config for clubmeisterschaft auto-import (~/.config/bowlyzer/clubmeisterschaft-import.env).
# Installed by scripts/install_clubmeisterschaft_auto_import.sh (run as bowlyzer, not root).

BOWLYZER_DIR=/home/bowlyzer/bowlyzer
DOCKER_IMAGE=bowlyzer:release

# rclone remote — dedicated Dropbox account (rclone config as bowlyzer)
# Folder in your Dropbox (sync folder contents into inbox):
CLUBMEISTERSCHAFT_RCLONE_SRC=dropbox_bowlyzer:Clubmeisterschaft_Donaubowler
# Production: data owner shared the xlsx directly — quote the *whole* value (spaces in filename)
# CLUBMEISTERSCHAFT_RCLONE_SRC="dropbox_bowlyzer:Clubpokal DB 2026.xlsx"
# CLUBMEISTERSCHAFT_RCLONE_SHARED_FILES=1

# Work dirs under ~/bowlyzer/work (bowlyzer-owned; no /var/lib)
CLUBMEISTERSCHAFT_INBOX=/home/bowlyzer/bowlyzer/work/clubmeisterschaft/inbox
CLUBMEISTERSCHAFT_WORK=/home/bowlyzer/bowlyzer/work/clubmeisterschaft/work
STATE_DIR=/home/bowlyzer/bowlyzer/work/clubmeisterschaft
# CLUBMEISTERSCHAFT_ARCHIVE=/home/bowlyzer/bowlyzer/work/clubmeisterschaft/archive

TOURNAMENT_INPUTS_DIR=/home/bowlyzer/bowlyzer/work/tournament_inputs
GF_TOURNAMENT_CSV=/home/bowlyzer/bowlyzer/work/tournament_inputs/gf_tournaments_2026__combined_postprocessed.csv

CLUBMEISTERSCHAFT_XLSX_NAME="Clubpokal DB 2026.xlsx"

IMPORT_DATE=2026-05-15
IMPORT_YEAR=2026
# IMPORT_SEASON=25/26

SKIP_RESTART=1

# Email when a new workbook is imported (requires NOTIFY_SMTP_* below).
CLUBMEISTERSCHAFT_NOTIFY_EMAIL=chris@bowlyzer.online
# IONOS Mail (bowlyzer.online) — match Thunderbird outgoing server exactly.
# NOTIFY_EMAIL_FROM=chris@bowlyzer.online
# NOTIFY_SMTP_HOST=smtp.ionos.de
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_USER=chris@bowlyzer.online
# NOTIFY_SMTP_SSL=0
# NOTIFY_SMTP_STARTTLS=1
# Or keep password out of this file:
# NOTIFY_SMTP_PASS_FILE=/home/bowlyzer/.config/bowlyzer/notify-smtp.pass
