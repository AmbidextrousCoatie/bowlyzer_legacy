# Copy on VPS to /etc/bowlyzer/clubmeisterschaft-import.env (chmod 600).
# Used by clubmeisterschaft-import.service (systemd).

BOWLYZER_DIR=/home/bowlyzer/bowlyzer
DOCKER_IMAGE=bowlyzer:release

# rclone remote path — dedicated Dropbox folder for Clubmeisterschaft Donaubowler 2026
CLUBMEISTERSCHAFT_RCLONE_SRC=dropbox:YOUR_FOLDER_HERE

CLUBMEISTERSCHAFT_INBOX=/var/lib/bowlyzer/clubmeisterschaft/inbox
CLUBMEISTERSCHAFT_WORK=/var/lib/bowlyzer/clubmeisterschaft/work

IMPORT_DATE=2026-05-15
IMPORT_YEAR=2026
# IMPORT_SEASON=25/26
